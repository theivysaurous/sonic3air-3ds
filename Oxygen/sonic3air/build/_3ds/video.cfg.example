# Optional video settings for the 3DS build.
# To use them, copy this file to /3ds/sonic3air/video.cfg on the SD card and remove the "#" in front of the lines you want.
# Changes need a restart of the game.

# Frame rate limit: 30 (default) or 60. 30 gives an even frame pace; 60 only helps if the game can actually reach it.
#fps=30

# Colour format of both screens: 24 (default, BGR8, also what NTR screen streaming decodes correctly) or 32 (RGBA8).
#format=24

# Write alpha 0 instead of 255 in 32-bit mode (old test, did not fix the NTR colours).
#alpha=0

# Bottom screen: "bottom=0" turns it off (fastest, around +10 fps).
#bottom=0

# "bottom=background" (default): the scrolling background layer of the level on the bottom screen.
# "bottom=scene": the whole level without sprites (all layers); looks fuller but costs more.
#bottom=background

# How often the bottom screen is updated: every N-th frame (default 2, 1 = every frame, up to 10). Higher is faster.
#bottom_rate=2
